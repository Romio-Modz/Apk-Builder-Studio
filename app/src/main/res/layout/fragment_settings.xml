<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Theme Mode Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Appearance"
            android:textAppearance="@style/TextAppearance.APKBuilder.Title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.APKBuilder.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="Theme Mode"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <RadioGroup
                    android:id="@+id/themeModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDefault"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Default" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbLight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Light" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbNight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Night" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Telegram Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Community"
            android:textAppearance="@style/TextAppearance.APKBuilder.Title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTelegram"
            style="@style/Widget.APKBuilder.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:backgroundTint="#229ED9"
            android:text="Join Our Telegram Channel"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_telegram"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart" />

        <!-- About Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/aboutCard"
            style="@style/Widget.APKBuilder.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:clickable="true"
            android:focusable="true"
            app:rippleColor="?attr/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_app_logo"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="About" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:text="About APK Builder Studio"
                        android:textAppearance="@style/TextAppearance.APKBuilder.Title" />

                    <ImageView
                        android:id="@+id/aboutArrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="Expand" />
                </LinearLayout>

                <TextView
                    android:id="@+id/aboutContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="APK Builder Studio v2.0\n\n=== Kaise Use Kare (Hindi) ===\n\nStep 1: GitHub account banao (github.com) aur Personal Access Token generate karo. Settings > Developer settings > Personal access tokens > Tokens (classic) > Generate new token. Scope me \'repo\' aur \'workflow\' dono tick karo. Token copy karo.\n\nStep 2: GitHub par ek naya repo banao (jaise RomiTube). Apna source code upload karo ya ZIP file extract karke files upload karo.\n\nStep 3: Is app me Build tab par jao. Apna GitHub Token, GitHub Username, aur Repo Name daalo.\n\nStep 4: Upload File button pe tap karke apna ZIP file ya source code files select karo. Files upload ho jayenge. View Uploaded Files pe tap karke check kar sakte ho.\n\nStep 5: App Name, Package Name, Version daalo. Min SDK 24 aur Target SDK 34 rakho.\n\nStep 6: Debug ya Release build choose karo. Start Build pe tap karo.\n\nStep 7: Build complete hone tak wait karo. Build log neeche dikhega. Jab build complete ho jaye, Download APK button se APK download karo aur install karo.\n\n=== How to Use (English) ===\n\nStep 1: Create a GitHub account (github.com) and generate a Personal Access Token. Go to Settings > Developer settings > Personal access tokens > Tokens (classic) > Generate new token. Check both \'repo\' and \'workflow\' scopes. Copy the token.\n\nStep 2: Create a new repository on GitHub (e.g. RomiTube). Upload your source code or extract your ZIP file and upload the files.\n\nStep 3: Go to the Build tab in this app. Enter your GitHub Token, GitHub Username, and Repo Name.\n\nStep 4: Tap the Upload File button and select your ZIP file or source code files. Files will be uploaded. Tap View Uploaded Files to check them.\n\nStep 5: Enter App Name, Package Name, and Version. Keep Min SDK 24 and Target SDK 34.\n\nStep 6: Choose Debug or Release build. Tap Start Build.\n\nStep 7: Wait for the build to complete. Build log will appear below. When the build is complete, download the APK using the Download APK button and install it.\n\nDeveloped By: The Romio Shaikh\nGitHub: @Romio-Modz"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer: Developed By -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/footerTelegram"
            style="@style/Widget.APKBuilder.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:rippleColor="?attr/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_md">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_telegram"
                    app:tint="?attr/colorOnPrimaryContainer"
                    android:contentDescription="Telegram" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Developed By The Romio Shaikh"
                    android:textAppearance="@style/TextAppearance.APKBuilder.Title"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Tap to join Telegram"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:alpha="0.7" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
